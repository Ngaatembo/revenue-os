{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "revenue-os",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Supabase PostgreSQL is the source of truth; the browser talks to Supabase directly under RLS.
  // Only public, non-secret values belong here. SUPABASE_ANON_KEY (publishable key) is set as a
  // Cloudflare variable or secret: `npx wrangler secret put SUPABASE_ANON_KEY`.
  "vars": {
    "SUPABASE_URL": "https://zivgfvcmposnbwqsudas.supabase.co"
  },
  "observability": {
    "enabled": true
  }
}
