{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "revenue-os",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Supabase PostgreSQL is the source of truth; the browser talks to Supabase directly under RLS.
  // Only public, non-secret values belong here. SUPABASE_ANON_KEY (publishable key) is set as a
  // Cloudflare variable or secret: `npx wrangler secret put SUPABASE_ANON_KEY`.
  "vars": {
    "SUPABASE_URL": "https://zivgfvcmposnbwqsudas.supabase.co"
  },
  // Required by `wrangler preview` (used by Workers Builds for non-production branches).
  // There is only one Supabase project, so previews read the same public URL; the health check
  // makes a read-only GET and the browser app already uses this project in every build.
  "previews": {
    "vars": {
      "SUPABASE_URL": "https://zivgfvcmposnbwqsudas.supabase.co"
    }
  },
  // Automatic synchronisation: due connections are synced every minute (each connection chooses its own cadence).
  "triggers": { "crons": ["* * * * *"] },
  "observability": {
    "enabled": true
  }
}
