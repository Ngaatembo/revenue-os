{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "revenue-os",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "revenue-os-local",
      // Local development placeholder only; replace with the ID returned by `wrangler d1 create` before any remote deployment.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
